OIDC_CLIENT_SECRET=sentinel-lab-secret-change-in-production
OIDC_REDIRECT_URI=http://localhost:5173/callback

# LLM Provider (optional)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=